{
  "name": "barber-delivery-app",
  "version": "1.0.0",
  "description": "Mobile barber service delivery platform - Book barbers to come to your location",
  "private": true,
  "scripts": {
    "dev": "pnpm turbo run dev",
    "dev:api": "pnpm --filter barber-delivery-backend dev",
    "dev:web": "pnpm --filter barber-delivery-frontend dev",
    "build": "pnpm turbo run build",
    "build:api": "pnpm --filter barber-delivery-backend build",
    "build:web": "pnpm --filter barber-delivery-frontend build",
    "lint": "pnpm biome check .",
    "format": "pnpm biome format --write .",
    "check": "pnpm biome check --write .",
    "typecheck": "pnpm turbo run typecheck",
    "test": "pnpm turbo run test",
    "clean": "pnpm -r exec -- rm -rf node_modules dist .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.0.0"
  }
}
